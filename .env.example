# 百炼 OpenAI 兼容 Responses API；原生 web_search
TRAVEL_MODEL=qwen3.8-flash
DASHSCOPE_API_KEY=
# 北京地域；也可替换为业务空间专属域名（须与 API Key 地域一致）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

AMAP_MAPS_API_KEY=

# 飞猪支持试用；正式 API Key 从飞猪开放平台获取
FLYAI_API_KEY=

# 可选：启用 LangSmith tracing 时填写
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=travel-agent
LANGSMITH_API_KEY=
